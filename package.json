{
  "name": "relai-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/deny-remote-network.mjs ./node_modules/vite/bin/vite.js --mode staging",
    "build": "node --import ./scripts/deny-remote-network.mjs ./node_modules/vite/bin/vite.js build --mode staging",
    "build:staging:validated": "npm run lint && npm run typecheck && npm test && npm run build && node --import ./scripts/deny-remote-network.mjs scripts/prepare-deploy-config.mjs staging && npm run verify:staging-build",
    "build:production": "node --import ./scripts/deny-remote-network.mjs ./node_modules/vite/bin/vite.js build --mode production",
    "preview": "npm run build && node --import ./scripts/deny-remote-network.mjs ./node_modules/vite/bin/vite.js preview",
    "lint": "node --import ./scripts/deny-remote-network.mjs ./node_modules/eslint/bin/eslint.js src scripts/*.mjs scripts/*.ts vite.config.ts vitest.config.ts eslint.config.js e2e/*.ts playwright.config.ts vite.e2e.config.ts",
    "typecheck": "node --import ./scripts/deny-remote-network.mjs ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/run-isolated-tests.mjs all",
    "test:routing": "node scripts/run-isolated-tests.mjs routing",
    "test:d1-schema": "node scripts/run-isolated-tests.mjs d1Schema",
    "test:persistence": "node scripts/run-isolated-tests.mjs persistence",
    "test:auth": "node scripts/run-isolated-tests.mjs auth",
    "test:auth-api": "node scripts/run-isolated-tests.mjs authApi",
    "verify:d1-schema:staging": "node scripts/verify-staging-d1-schema.mjs",
    "verify:d1-config": "node --import ./scripts/deny-remote-network.mjs scripts/verify-d1-config.mjs",
    "db:migrations:create": "node --import ./scripts/deny-remote-network.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations create relai-staging-db --config wrangler.jsonc --env staging",
    "db:migrations:list:local": "node --import ./scripts/deny-remote-network.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations list relai-staging-db --config wrangler.jsonc --env staging --local",
    "db:migrations:apply:local": "node --import ./scripts/deny-remote-network.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply relai-staging-db --config wrangler.jsonc --env staging --local",
    "db:migrations:list:staging": "node scripts/run-remote-wrangler.mjs staging-migration-list",
    "db:migrations:apply:staging": "node scripts/run-remote-wrangler.mjs staging-migration-apply",
    "db:info:production": "node scripts/run-remote-wrangler.mjs production-d1-info",
    "db:migrations:list:production": "node scripts/run-remote-wrangler.mjs production-migration-list",
    "db:migrations:apply:production": "node scripts/run-remote-wrangler.mjs production-migration-apply",
    "verify:staging-build": "node --import ./scripts/deny-remote-network.mjs scripts/verify-staging-build.mjs",
    "verify:staging-health": "node scripts/verify-staging-health.mjs",
    "deploy": "node scripts/deploy-staging.mjs --build",
    "deploy:staging:built": "node scripts/deploy-staging.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "user:manage": "tsx scripts/manage-user.ts",
    "catalog:import": "tsx scripts/import-cefr-j.ts",
    "test:admin": "node scripts/run-isolated-tests.mjs admin",
    "test:e2e": "node scripts/run-isolated-tests.mjs e2e",
    "test:e2e:headed": "node scripts/run-isolated-tests.mjs e2e --headed",
    "test:e2e:ui": "node scripts/run-isolated-tests.mjs e2e --ui",
    "test:e2e:debug": "node scripts/run-isolated-tests.mjs e2e --debug",
    "test:e2e:report": "node --import ./scripts/deny-remote-network.mjs ./node_modules/@playwright/test/cli.js show-report",
    "test:e2e:trace": "node --import ./scripts/deny-remote-network.mjs ./node_modules/@playwright/test/cli.js show-trace"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.0.0",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
