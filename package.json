{
  "name": "relai-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode staging",
    "build": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "npm run build && vite preview",
    "lint": "eslint src scripts/routing.test.mjs scripts/verify-d1-config.mjs vite.config.ts vitest.config.ts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run verify:d1-config",
    "test:routing": "npm run build && node --test scripts/routing.test.mjs",
    "verify:d1-config": "node scripts/verify-d1-config.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:production": "npm run build:production && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
