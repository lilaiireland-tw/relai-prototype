# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
**/.dev.vars*

# Locally generated output from removed legacy frontend checkouts
**/.next/
**/.next-relai/
**/__pycache__/
**/.pytest_cache/
**/.venv/
.venv/

# production
/build
/dist
/.wrangler/
/data/cefr-j-local/
.dev.vars*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example
!**/.env.example

# claude code local settings (machine-specific, may contain command history with secrets)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
