{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relai-prototype-staging",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/relaiapp/api", "/relaiapp/api/*"]
  },
  // The default is staging so unqualified local/build commands cannot use production.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relai-staging-db",
      "database_id": "41ead93a-40f6-4016-b49c-df00a18e86da",
      "migrations_dir": "migrations"
    }
  ],
  // Bindings are non-inheritable: keep each environment explicit.
  "env": {
    "staging": {
      "name": "relai-prototype-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "GEMINI_MODEL": "gemini-3.1-flash-lite"
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "relai-staging-db",
          "database_id": "41ead93a-40f6-4016-b49c-df00a18e86da",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "IMAGE_STORAGE", "bucket_name": "relai-vocabulary-images-staging" }
      ],
      "queues": {
        "producers": [
          { "binding": "IMAGE_JOBS", "queue": "relai-vocab-image-jobs-staging" }
        ],
        "consumers": [
          { "queue": "relai-vocab-image-jobs-staging", "max_batch_size": 1, "max_retries": 5,
            "retry_delay": 30, "dead_letter_queue": "relai-vocab-image-jobs-staging-dlq", "max_concurrency": 5 }
        ]
      },
      "triggers": { "crons": ["* * * * *"] }
    },
    "production": {
      "name": "relai-prototype",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "relai-prod-db",
          "database_id": "73e85c43-fe58-4357-8196-e68c7dda00ee",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
